index 0000000..37d1001
--- /dev/null
+++ b/.github/workflows/nuget-verify.yml
@@ -0,0 +1,40 @@
+name: Verify NuGet publication
+
+on:
+  workflow_dispatch:
+    inputs:
+      version:
+        description: Existing DanceRudiments version to verify on NuGet.org
+        required: true
+        type: string
+
+permissions:
+  contents: read
+
+jobs:
+  verify:
+    runs-on: ubuntu-22.04
+    steps:
+      - uses: actions/checkout@v6
+        with:
+          persist-credentials: false
+      - uses: actions/setup-python@v6
+        with:
+          python-version: '3.13'
+      - name: Download the package already attached to its GitHub Release
+        env:
+          GH_TOKEN: ${{ github.token }}
+          VERSION: ${{ inputs.version }}
+        shell: bash
+        run: |
+          set -euo pipefail
+          [[ "$VERSION" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]]
+          mkdir -p artifacts/nuget
+          gh release download "v$VERSION" --repo "$GITHUB_REPOSITORY" \
+            --pattern "DanceRudiments.$VERSION.nupkg" --dir artifacts/nuget
+      - name: Wait for NuGet.org indexing and verify the published payload
+        env:
+          VERSION: ${{ inputs.version }}
+        run: |
+          python tools/csharp_package.py verify-published \
+            "artifacts/nuget/DanceRudiments.$VERSION.nupkg" --version "$VERSION"
