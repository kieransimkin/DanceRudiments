+*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--ink);font:15px/1.5 system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif}header,main,footer,.transport{max-width:1500px;margin:auto;padding:28px 36px}header{padding-top:40px;padding-bottom:18px}.eyebrow{font-size:11px;letter-spacing:.18em;color:var(--accent);font-weight:700}.heading{display:flex;align-items:center;justify-content:space-between;gap:20px}h1{font-size:clamp(29px,3.2vw,45px);letter-spacing:-.035em;margin:9px 0 3px;line-height:1.2}h2{font-size:19px;margin:0;letter-spacing:-.015em}h3{font-size:17px;margin:0;line-height:1.3}.subtitle{color:var(--muted);margin:0;font-size:15px}.intro{max-width:950px;color:var(--muted);margin-bottom:0}.badge{padding:6px 11px;border:1px solid var(--line);border-radius:30px;white-space:nowrap;color:var(--accent);font-size:12px}.transport{background:#151b25;border-block:1px solid var(--line);padding-top:18px;padding-bottom:12px}main{padding-top:20px}.row{display:flex;align-items:center;gap:10px 16px;flex-wrap:wrap}.row+.row{margin-top:12px}.row label{display:flex;align-items:center;gap:8px;color:var(--muted);font-size:13px}input,button,select,.file-label{font:inherit;border:1px solid #3a465c;border-radius:7px;color:var(--ink);background:#1c2533}button,.file-label{padding:7px 12px;cursor:pointer;line-height:1.4}button:hover,.file-label:hover{background:#2a3547;border-color:#718098}button:disabled{opacity:.38;cursor:not-allowed}.primary{background:var(--accent);border-color:var(--accent);color:#122e29;font-weight:700;min-width:80px}.primary:hover{color:var(--ink)}input[type=number]{width:80px;padding:6px}input[type=search]{padding:7px;width:100%;min-width:120px}select{padding:7px}input[type=range]{accent-color:var(--accent);padding:0;max-width:170px}input[type=checkbox]{accent-color:var(--accent)}button:focus-visible,input:focus-visible,select:focus-visible,summary:focus-visible,.file-label:focus-within{outline:2px solid var(--accent);outline-offset:3px}.file-label{position:relative;overflow:hidden;display:inline-flex!important;color:var(--ink)!important}.file-label input[type=file]{position:absolute;width:100%;height:100%;inset:0;opacity:0;cursor:pointer}.seek{flex:1;min-width:210px}.seek input{max-width:none;width:100%}#clock{margin-left:auto;color:var(--accent);font-variant-numeric:tabular-nums;font-size:13px;min-width:125px}.small{font-size:12px;color:var(--muted)}details{margin-top:10px;color:var(--muted);font-size:13px}summary{cursor:pointer}.audio-row{margin-top:10px}audio{height:35px;max-width:100%}#offset{width:90px}.filters{margin-bottom:20px}.search{flex:1}#status{min-height:18px;margin:10px 0 0}.subtle{color:var(--muted)}.section-label{justify-content:space-between;margin-bottom:14px}.grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:16px}.card{background:var(--panel);border:1px solid var(--line);border-radius:13px;overflow:hidden;min-width:0}.card-head{padding:16px 16px 10px}.card-id{display:flex;justify-content:space-between;gap:4px;font-size:10px;letter-spacing:.08em;text-transform:uppercase;color:var(--muted);margin-bottom:6px}.period{color:#dbe5f2}.stage{width:100%;height:165px;display:block;background:#111923}.wave{width:100%;height:49px;display:block;background:#111923;border-top:1px solid #222f40}.card-body{padding:11px 16px 14px}.desc{font-size:12px;color:var(--muted);min-height:54px;margin:0 0 10px}.review-buttons{display:flex;gap:6px}.review-buttons button{font-size:12px;flex:1;padding:6px}.review-buttons button[aria-pressed=true]{font-weight:700;color:#0d2924;background:var(--keep);border-color:var(--keep)}.review-buttons .maybe[aria-pressed=true]{background:var(--maybe);border-color:var(--maybe);color:#352814}.review-buttons .skip[aria-pressed=true]{background:var(--skip);border-color:var(--skip);color:#30202b}.card-bottom{display:flex;justify-content:space-between;align-items:center;gap:6px;margin-top:11px;font-size:12px}.card-bottom label{color:var(--muted);display:flex;align-items:center;gap:5px}.source-button{border:0;padding:3px 0;background:none;color:var(--accent);font-size:11px;text-decoration:underline;text-underline-offset:3px}.note{width:100%;margin-top:10px;padding:5px 7px;font-size:11px;border-color:#303b50}.comparison{border:1px solid #475d6c;border-radius:12px;padding:18px;margin-bottom:22px;background:#131d28}.comparison>.row{margin-bottom:15px}#compare-grid{grid-template-columns:repeat(auto-fit,minmax(210px,1fr))}#compare-grid .stage{height:205px}#compare-grid .desc{min-height:0}footer{margin-top:24px;border-top:1px solid var(--line);color:var(--muted);font-size:12px;padding-bottom:35px}footer p{max-width:1080px}footer strong{color:var(--ink)}dialog{background:#151c27;color:var(--ink);border:1px solid #54617a;border-radius:12px;max-width:min(850px,94vw);max-height:85vh;padding:22px}dialog::backdrop{background:#070c13bd}dialog .row{justify-content:space-between}pre{white-space:pre-wrap;overflow-wrap:anywhere;font:12px/1.6 ui-monospace,monospace;color:#c7d4e5}#empty{color:var(--muted)}[hidden]{display:none!important}
