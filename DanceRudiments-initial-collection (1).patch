+    if (!comparison) {
+      const buttons=node('div','review-buttons');
+      for (const [value,label] of [['keep','Keep'],['maybe','Maybe'],['skip','Skip']]) {
+        const b=node('button',value,label); b.setAttribute('aria-pressed',reviews.get(p.name).status===value?'true':'false');
