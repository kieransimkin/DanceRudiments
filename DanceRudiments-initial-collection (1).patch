+  }
+  function draw(beat=beatNow()) {
+    if (!native) return;
+    const absolutePip=Math.floor(beat*64+1e-8);
+    const pip=((absolutePip%512)+512)%512;
+    $('clock').textContent=`Beat ${Math.floor(beat)+1} · pip ${((absolutePip%64)+64)%64}`;
+    $('seek').value=pip;
