+    for (let p=0;p<=period;p+=64) { const x=p/period*wb.width;wc.beginPath();wc.moveTo(x,0);wc.lineTo(x,wb.height);wc.stroke(); }
+    ['#bcacf8','#83e8d0'].forEach((color,axis) => {
+      wc.strokeStyle=color;wc.lineWidth=dpr;wc.beginPath();
