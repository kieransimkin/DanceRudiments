+    if ($('trails').checked) {
+      ctx.strokeStyle='#556c83';ctx.lineWidth=dpr;ctx.beginPath();
+      curves[i].forEach((v,j)=>{const x=w/2+v[0]*scale,y=h/2+v[1]*scale;j?ctx.lineTo(x,y):ctx.moveTo(x,y);});
