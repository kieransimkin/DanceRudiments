# Exact source-byte identities and deterministic generated tables must survive
# Windows checkouts; limit this policy to the new optional collection assets.
collections/initial/** text eol=lf
harness/initial/** text eol=lf
harness/initial-collection.html text eol=lf
python/dancerudiments_authoring/packs/** text eol=lf
include/dancerudiments/collections/** text eol=lf
# Preserve byte-for-byte upstream tables (including upstream trailing spaces).
collections/initial/sources/akwf/*.h -whitespace

# Expansion scores and hash-locked registry must retain LF on every platform.
collections/expansion/** text eol=lf
collections/atlas/** text eol=lf
collections/defaults.json text eol=lf
include/dancerudiments/detail/** text eol=lf

# Continuum recipes contain byte-hashed source manifests.
collections/continuum/** text eol=lf

# Club Rhythms source hashes and generated files are platform-independent.
collections/club/** text eol=lf

collections/dancefloor/** text eol=lf

# The self-contained HTML's audit sidecar hashes exact bytes on every platform.
harness/index.html text eol=lf
harness/index.json text eol=lf
harness/beats.json text eol=lf

# Keep original DanceFlow artwork byte-identical across platform packages.
**/branding/*.svg text eol=lf
**/branding/*.png binary

# Recording WASM provenance hashes the actual C++ source bytes. Do not let
# core.autocrlf turn these into CRLF on Windows; do not weaken the SHA tests.
tools/recording_wasm.cpp text eol=lf
include/dancerudiments/recording_view.hpp text eol=lf
python/dancerudiments_authoring/harness_assets/recording.wasm.json text eol=lf
python/dancerudiments_authoring/harness_assets/recording.wasm.b64 text eol=lf

# Numbered rig profiles and source provenance remain reproducible on Windows.
python/dancerudiments_authoring/rig_profiles/** text eol=lf
python/dancerudiments_authoring/motion_sources/** text eol=lf
examples/rig-motion/** text eol=lf
