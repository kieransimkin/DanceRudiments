<Project Sdk="Microsoft.NET.Sdk">
  <!-- Music: https://kieransimkin.co.uk/my-songs/ -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup Condition="'$(UsePackedBinding)' != 'true'">
    <ProjectReference Include="../../../bindings/csharp/DanceRudiments/DanceRudiments.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(UsePackedBinding)' == 'true'">
    <PackageReference Include="DanceRudiments" Version="$(BindingPackageVersion)" />
  </ItemGroup>
</Project>
