{
  "format": "dancerudiments.score-pack",
  "schema_version": 1,
  "patterns": [
    {
      "name": "wobble_xy",
      "description": "Two-beat XY orbit with a syncopated small vertical pulse",
      "period_beats": 2,
      "tracks": [
        {"axis": "x", "curve": {"type": "lfo", "shape": "sine", "period_beats": 2, "gain": 0.6}},
        {"axis": "y", "curve": {"type": "lfo", "shape": "sine", "period_beats": 2, "phase": "1/4", "gain": 0.4}}
      ],
      "gestures": {"accent": {"duration_beats": "1/2", "axes": {"y": -0.2}}},
      "events": [{"beat": "1/3", "gesture": "accent", "anchor": "peak"}],
      "provenance": {"author": "Kieran Simkin / DanceRudiments contributors", "license": "MIT", "source": "Original infrastructure example, not a third-party preset"}
    },
    {
      "name": "triplet_steps",
      "description": "Three peak-anchored gestures per beat; no rounded-duration drift",
      "period_beats": 1,
      "gestures": {
        "right": {"duration_beats": "1/3", "axes": {"x": 0.8, "y": -0.25}},
        "left": {"duration_beats": "1/3", "axes": {"x": -0.8, "y": -0.25}}
      },
      "events": [
        {"beat": 0, "gesture": "right", "anchor": "peak"},
        {"beat": "1/3", "gesture": "left", "anchor": "peak"},
        {"beat": "2/3", "gesture": "right", "anchor": "peak", "strength": 0.6}
      ],
      "provenance": {"license": "MIT", "source": "Original rational-event example"}
    },
    {
      "name": "segmented_sway",
      "description": "Three-beat eased curve with an asymmetric cubic return",
      "period_beats": 3,
      "tracks": [{"axis": "x", "curve": {"type": "keyframes", "points": [
        {"beat": 0, "value": 0, "interpolation": "smoothstep"},
        {"beat": 1, "value": 0.8, "interpolation": "cubic", "control1": 0.8, "control2": -0.8},
        {"beat": 2, "value": -0.8, "interpolation": "smootherstep"},
        {"beat": 3, "value": 0}
      ]}}],
      "provenance": {"license": "MIT", "source": "Original segmented-curve example"}
    },
    {
      "name": "seeded_drift",
      "description": "Eight-beat deterministic smooth random motion",
      "period_beats": 8,
      "tracks": [
        {"axis": "x", "curve": {"type": "random_smooth", "steps": 7, "seed": 98, "gain": 0.7}},
        {"axis": "y", "curve": {"type": "random_smooth", "steps": 5, "seed": 985, "gain": 0.5}}
      ],
      "provenance": {"license": "MIT", "source": "Original hash-indexed periodic curve"}
    }
  ]
}
